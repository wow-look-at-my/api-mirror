<?xml version="1.1" encoding="UTF-8"?>

<!--
	A caching mirror of the GitHub REST API, declared rather than written.

	This file is the point of the project. github-state-mirror implements the
	same thing by hand, and every mechanism in it is generic except the
	vocabulary below: which fields exist, which payload field carries a
	delivery's clock, and what "public" means here. The engine holds the rest -
	the derived schema, the freshness bookkeeping, the ordering, the reveal
	ladder, the passthrough.

	Read docs/design.md before editing. Whitespace: structural indentation is
	TABS.
-->

<mirror name="github" schema="../../mirror.schema.xsd">

	<description>Caching mirror of the GitHub REST API. Storage is global -- one row per fact, no actor column -- and a read is gated by proof that the caller could have read the same thing from GitHub directly. Set GITHUB_API_URL to target a GitHub Enterprise Server instance.</description>

	<vars>
		<var name="base"><value name="env.GITHUB_API_URL" default="https://api.github.com"/></var>
	</vars>

	<!--
		The caller's own Authorization rides every request the mirror makes on
		their behalf. That is what makes a probe prove THAT caller's access
		rather than the mirror's, and it is why the mirror never needs a
		credential of its own to serve a read.
	-->
	<upstream base="{{ .var.base }}">
		<header name="Accept">application/vnd.github+json</header>
		<header name="X-GitHub-Api-Version">2022-11-28</header>
		<forward name="Authorization"/>
	</upstream>

	<!--
		A repository. Its visibility is load-bearing twice over: it is the fast
		path of the reveal ladder, and an UNKNOWN visibility must read as
		private. The predicate below says "public" explicitly rather than "not
		private", so a row the mirror has never confirmed fails closed.
	-->
	<resource name="repo" ttl="6h">
		<key name="owner" from="owner.login" fold="true"/>
		<key name="name" from="name" fold="true"/>
		<field name="repo_id" type="int">id</field>
		<field name="visibility" type="text">visibility</field>
		<field name="private" type="bool">private</field>
		<field name="default_branch" type="text">default_branch</field>
		<field name="pushed_at" type="time">pushed_at</field>
		<field name="archived" type="bool">archived</field>
		<field name="topics" type="json">topics</field>
		<reveal>
			<public>{{ eq .row.visibility "public" }}</public>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.name }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- An open pull request. -->
	<resource name="pull" ttl="1h">
		<key name="owner" from="base.repo.owner.login" fold="true"/>
		<key name="repo" from="base.repo.name" fold="true"/>
		<key name="number" from="number"/>
		<field name="title" type="text">title</field>
		<field name="state" type="text">state</field>
		<field name="draft" type="bool">draft</field>
		<field name="head_sha" type="text">head.sha</field>
		<field name="head_ref" type="text">head.ref</field>
		<field name="base_ref" type="text">base.ref</field>
		<field name="base_sha" type="text">base.sha</field>
		<field name="merged" type="bool">merged</field>
		<field name="merge_commit_sha" type="text">merge_commit_sha</field>
		<field name="updated_at" type="time">updated_at</field>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!--
		A branch tip. This is the answer a lost delivery ruins worst: a stale
		tip reads as "nothing to do", which stops the very work that would
		refresh it. A push STATES the new tip in `after`, so the delivery is
		the answer and no fetch is needed to learn it.
	-->
	<resource name="branch" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="ref"/>
		<field name="tip_sha" type="text">object.sha</field>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- One commit status, keyed by sha AND context. -->
	<resource name="commit_status" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="sha"/>
		<key name="context"/>
		<field name="state" type="text">state</field>
		<field name="description" type="text">description</field>
		<field name="updated_at" type="time">updated_at</field>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!--
		One historical status POST. Append-only: GitHub never mutates or
		deletes a posted status, it only adds a newer one for the same
		context. Keyed by GitHub's own status id, so a redelivered or
		re-fetched post upserts onto itself rather than duplicating. Distinct
		from `commit_status` above, which holds the latest-per-context
		rollup; this one holds the full history the raw list endpoint (a
		bare array, unlike the enveloped combined-status endpoint) answers
		with.
	-->
	<resource name="status_post" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="sha"/>
		<key name="id"/>
		<field name="context" type="text">context</field>
		<field name="state" type="text">state</field>
		<field name="description" type="text">description</field>
		<field name="target_url" type="text">target_url</field>
		<field name="created_at" type="time">created_at</field>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="contents" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="path"/>
		<key name="ref"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- A git commit object is immutable (content-addressed by sha), so a long TTL approximates gsm's no-TTL-plus-LRU stance. -->
	<resource name="git_commit" ttl="720h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="sha" fold="true"/>
		<field name="message" type="text">message</field>
		<field name="author_name" type="text">author.name</field>
		<field name="author_email" type="text">author.email</field>
		<field name="author_date" type="text">author.date</field>
		<field name="committer_name" type="text">committer.name</field>
		<field name="committer_email" type="text">committer.email</field>
		<field name="committer_date" type="text">committer.date</field>
		<field name="tree_sha" type="text">tree.sha</field>
		<drop>url</drop>
		<drop>*_url</drop>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- A git tree is content-addressed too; recursive is part of the key because GitHub answers a different entry set for the same sha depending on it. -->
	<resource name="git_tree" store="document" ttl="720h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="sha" fold="true"/>
		<key name="recursive"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- The general /git/ref/{ref} path (tags and other ref kinds, not just heads; see "branch" above for the heads/{ref} shortcut). -->
	<resource name="git_ref" store="document" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="ref"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="matching_refs" store="document" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="prefix"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- Simplified vs gsm's own shas-array-of-refs snapshot: this stores the rendered page directly rather than a pointer into git_commit rows. -->
	<resource name="commits_list" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="sha"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="compare" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="basehead"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- Split from gsm's single kind-discriminated table: this spec's route has no way to supply a literal "kind" value for a resource key, so status and check-runs each get their own resource instead. -->
	<resource name="commit_status_rollup" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="ref"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="commit_check_runs" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="ref"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="check_run" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="check_run_id"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- Only the per-commit-filtered listing (?head_sha=); gsm deliberately does NOT snapshot the repo-wide listing (no signal can name a run entering/leaving "queued"); same gap here. -->
	<resource name="workflow_runs" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="head_sha" fold="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<!-- Split from gsm's kind-discriminated table for the same reason as commit_ci above. -->
	<resource name="workflow_run_jobs" store="document" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="run_id"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="workflow_job" store="document" ttl="10m">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="job_id"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="code_quality_setup" store="document" ttl="1h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="label" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="name"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="branches_list" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="pull_files" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="number"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<resource name="pull_commits" store="document" ttl="24h">
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="number"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal>
			<probe method="GET" path="/repos/{{ .key.owner }}/{{ .key.repo }}"/>
			<grant ttl="24h"/>
			<deny ttl="5m"/>
		</reveal>
	</resource>

	<route method="GET" path="/repos/{owner}/{name}" resource="repo">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<!-- GitHub's 404 for a repository is an answer worth remembering. -->
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/pulls" resource="pull" list="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="state" type="text" default="open"/>
		<param name="per_page" type="int" default="30" min="1" max="100"/>
		<param name="page" type="int" default="1" min="1" max="100"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/pulls/{number}" resource="pull">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/git/ref/heads/{ref}" resource="branch">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<!--
		The raw statuses list answers a bare JSON array, unlike the enveloped
		combined-status endpoint (`{state, statuses:[...]}`). Not
		`complete="true"`: statuses are append-only history, so a page never
		omits something that was deleted. There is nothing here to delete.
	-->
	<route method="GET" path="/repos/{owner}/{repo}/commits/{sha}/statuses" resource="status_post" list="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100"/>
		<param name="page" type="int" default="1" min="1" max="100"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/contents/{path}" resource="contents">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="ref" type="text" default="" key="true"/>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/git/commits/{sha}" resource="git_commit">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/git/trees/{sha}" resource="git_tree">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="recursive" type="text" default="" key="true"/>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/git/ref/{ref}" resource="git_ref">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/git/matching-refs/heads/{prefix}" resource="matching_refs">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/commits" resource="commits_list" list="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="sha" type="text" default="" key="true"/>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/compare/{basehead}" resource="compare">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/commits/{ref}/status" resource="commit_status_rollup">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/commits/{ref}/check-runs" resource="commit_check_runs">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/check-runs/{check_run_id}" resource="check_run">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/actions/runs" resource="workflow_runs" list="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="head_sha" type="text" default="" key="true"/>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/actions/runs/{run_id}/jobs" resource="workflow_run_jobs" list="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/actions/jobs/{job_id}" resource="workflow_job">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/code-quality/setup" resource="code_quality_setup">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/labels/{name}" resource="label">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/branches" resource="branches_list" list="true" complete="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/pulls/{number}/files" resource="pull_files" list="true" complete="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<route method="GET" path="/repos/{owner}/{repo}/pulls/{number}/commits" resource="pull_commits" list="true" complete="true">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<!--
		Every delivery states the moment its view is from, and what that view
		is OF. Both are required: an upstream orders nothing it sends, so a
		redelivered payload from before a merge will happily reopen a merged
		pull request unless the engine can tell it is looking at the past.

		The clock is always a field GITHUB sets. A commit's own timestamp is
		user-settable - it survives a rebase and it can be in the future -
		so it is never the clock, however tempting its name.
	-->
	<events path="/webhook" signature-header="X-Hub-Signature-256" type-header="X-GitHub-Event" reorder-window="2s">

		<secret><value name="env.WEBHOOK_SECRET"/></secret>

		<event type="repository" resource="repo" clock="repository.updated_at">
			<subject>repo:<value name="payload.repository.full_name"/></subject>
			<apply>
				<set field="owner">repository.owner.login</set>
				<set field="name">repository.name</set>
				<set field="repo_id">repository.id</set>
				<set field="visibility">repository.visibility</set>
				<set field="private">repository.private</set>
				<set field="default_branch">repository.default_branch</set>
				<set field="archived">repository.archived</set>
			</apply>
		</event>

		<!--
			A push carries the branch's exact new tip. Writing it is the whole
			handler: there is nothing here to fetch, and flushing the row so
			the next reader refetches would buy back a fact GitHub just handed
			over.

			The subject is the REF, not the repository: two branches pushed at
			once are two independent views, and ordering them against each
			other would discard one.
		-->
		<event type="push" resource="branch" clock="repository.pushed_at">
			<subject>ref:<value name="payload.repository.full_name"/>:<value name="payload.ref"/></subject>
			<apply>
				<set field="owner">repository.owner.login</set>
				<set field="repo">repository.name</set>
				<set field="ref" expr='{{ trimPrefix "refs/heads/" .payload.ref }}'/>
				<set field="tip_sha">after</set>
			</apply>
		</event>

		<event type="pull_request" resource="pull" clock="pull_request.updated_at">
			<subject>pr:<value name="payload.repository.full_name"/>#<value name="payload.number"/></subject>
			<apply>
				<set field="owner">repository.owner.login</set>
				<set field="repo">repository.name</set>
				<set field="number">number</set>
				<set field="title">pull_request.title</set>
				<set field="state">pull_request.state</set>
				<set field="draft">pull_request.draft</set>
				<set field="head_sha">pull_request.head.sha</set>
				<set field="head_ref">pull_request.head.ref</set>
				<set field="base_ref">pull_request.base.ref</set>
				<set field="base_sha">pull_request.base.sha</set>
				<set field="merged">pull_request.merged</set>
				<set field="merge_commit_sha">pull_request.merge_commit_sha</set>
				<set field="updated_at">pull_request.updated_at</set>
			</apply>
		</event>

		<!--
			The subject keys the sha AND the context. Keyed on the sha alone,
			a slow check reporting second would discard a fast check's result
			that was posted first.
		-->
		<event type="status" resource="commit_status" clock="updated_at">
			<subject>status:<value name="payload.repository.full_name"/>:<value name="payload.sha"/>:<value name="payload.context"/></subject>
			<apply>
				<set field="owner">repository.owner.login</set>
				<set field="repo">repository.name</set>
				<set field="sha">sha</set>
				<set field="context">context</set>
				<set field="state">state</set>
				<set field="description" null="allow">description</set>
				<set field="updated_at">updated_at</set>
			</apply>
		</event>

	</events>

	<!--
		Each key is the CALLER'S OWN credential fingerprint (the engine's
		credential="true" key), not owner/repo: the answer belongs to that one
		token (its installation coverage, its own rate-limit standing, its own
		profile), so <reveal><credential/></reveal> replaces the probe/grant
		ladder: the key already proves access, and no other caller can ever
		address the row.

		PATCH/DELETE on hooks, labels and code-quality/setup are declared
		below as <purge>: forwarded verbatim, and the row they changed is
		dropped once the upstream confirms the write happened.

		POST /app/installations/{id}/access_tokens stays passthrough: it
		mints a new secret rather than changing an existing fact, so there is
		no row for a purge to drop.
	-->
	<resource name="identity" store="document">
		<key name="token_fp" credential="true"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/user" resource="identity">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
	</route>

	<resource name="user_orgs" store="document">
		<key name="token_fp" credential="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/user/orgs" resource="user_orgs">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<resource name="user_repos" store="document">
		<key name="token_fp" credential="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/user/repos" resource="user_repos">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<resource name="rate_limit" store="document" ttl="1m">
		<key name="token_fp" credential="true"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/rate_limit" resource="rate_limit">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
	</route>

	<resource name="org_runners" store="document">
		<key name="token_fp" credential="true"/>
		<key name="org" fold="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/orgs/{org}/actions/runners" resource="org_runners">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<resource name="repo_hooks" store="document">
		<key name="token_fp" credential="true"/>
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/repos/{owner}/{repo}/hooks" resource="repo_hooks">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<resource name="repo_hook" store="document">
		<key name="token_fp" credential="true"/>
		<key name="owner" fold="true"/>
		<key name="repo" fold="true"/>
		<key name="hook_id"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/repos/{owner}/{repo}/hooks/{hook_id}" resource="repo_hook">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<resource name="org_hooks" store="document">
		<key name="token_fp" credential="true"/>
		<key name="org" fold="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/orgs/{org}/hooks" resource="org_hooks">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<resource name="org_hook" store="document">
		<key name="token_fp" credential="true"/>
		<key name="org" fold="true"/>
		<key name="hook_id"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/orgs/{org}/hooks/{hook_id}" resource="org_hook">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<absorb status="404"/>
	</route>

	<!--
		A write is never cached itself, so it is forwarded and the row it
		changed is dropped on success instead: the next read refetches rather
		than replaying what the write just made stale.
	-->
	<purge method="PATCH" path="/repos/{owner}/{repo}/hooks/{hook_id}" resource="repo_hook"/>
	<purge method="DELETE" path="/repos/{owner}/{repo}/hooks/{hook_id}" resource="repo_hook"/>
	<purge method="PATCH" path="/orgs/{org}/hooks/{hook_id}" resource="org_hook"/>
	<purge method="DELETE" path="/orgs/{org}/hooks/{hook_id}" resource="org_hook"/>
	<purge method="PATCH" path="/repos/{owner}/{repo}/labels/{name}" resource="label"/>
	<purge method="DELETE" path="/repos/{owner}/{repo}/labels/{name}" resource="label"/>
	<purge method="PUT" path="/repos/{owner}/{repo}/code-quality/setup" resource="code_quality_setup"/>
	<purge method="DELETE" path="/repos/{owner}/{repo}/code-quality/setup" resource="code_quality_setup"/>

	<!--
		GitHub filters hits to what the caller's token can see, so the query
		text alone is not a safe key: the credential is part of it here too.
	-->
	<resource name="search_issues" store="document" ttl="1m">
		<key name="token_fp" credential="true"/>
		<key name="q"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/search/issues" resource="search_issues">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="q" type="text" default="" key="true"/>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<!--
		App-JWT-authenticated: the App's own identity, its installations, and
		one installation's repo coverage. Still credential-keyed: a JWT is
		still a caller's own credential, so the same shape applies.
	-->
	<resource name="app_identity" store="document">
		<key name="token_fp" credential="true"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/app" resource="app_identity">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
	</route>

	<resource name="app_installations" store="document">
		<key name="token_fp" credential="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/app/installations" resource="app_installations">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

	<resource name="installation_repos" store="document">
		<key name="token_fp" credential="true"/>
		<key name="per_page"/>
		<key name="page"/>
		<reveal><credential/></reveal>
	</resource>

	<route method="GET" path="/installation/repositories" resource="installation_repos">
		<accept>application/json</accept>
		<accept>application/vnd.github+json</accept>
		<param name="per_page" type="int" default="30" min="1" max="100" key="true"/>
		<param name="page" type="int" default="1" min="1" max="100" key="true"/>
	</route>

</mirror>
