<?xml version="1.1" encoding="UTF-8"?>

<!--
	Reference schema for an api-mirror spec.

	The loader is authoritative: it rejects things this file cannot express,
	and its messages say why. This exists for editor completion and for
	reading. TestReferenceSchemaKnowsEveryNameTheShippedSpecsUse walks both
	shipped specs and fails when this file has not kept up with them.
-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

	<!-- Placeholders, shared with api-cli through api-dsl. -->
	<xs:complexType name="value">
		<xs:attribute name="name" type="xs:string"/>
		<xs:attribute name="expr" type="xs:string"/>
		<xs:attribute name="default" type="xs:string"/>
		<xs:attribute name="as" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="ifType" mixed="true">
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="test" type="xs:string" use="required"/>
		<xs:attribute name="eq" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="forType" mixed="true">
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="each" type="xs:string" use="required"/>
	</xs:complexType>

	<xs:group name="placeholders">
		<xs:choice>
			<xs:element name="value" type="value"/>
			<xs:element name="if" type="ifType"/>
			<xs:element name="for" type="forType"/>
			<xs:element name="else"/>
		</xs:choice>
	</xs:group>

	<xs:complexType name="content" mixed="true">
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
	</xs:complexType>

	<xs:simpleType name="fieldType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="text"/>
			<xs:enumeration value="int"/>
			<xs:enumeration value="bool"/>
			<xs:enumeration value="time"/>
			<xs:enumeration value="json"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- The spec. -->
	<xs:element name="mirror">
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="description" type="xs:string"/>
				<!-- A media type every JSON route answers as its default representation. -->
				<xs:element name="accept" type="xs:string"/>
				<xs:element name="vars" type="vars"/>
				<xs:element name="upstream" type="upstream"/>
				<xs:element name="resource" type="resource"/>
				<xs:element name="route" type="route"/>
				<xs:element name="purge" type="purge"/>
				<xs:element name="rewrite" type="rewrite"/>
				<xs:element name="relay" type="relay"/>
				<xs:element name="events" type="events"/>
				<xs:element name="dashboard" type="dashboard"/>
				<xs:element name="cors" type="cors"/>
				<xs:element name="notify" type="notify"/>
				<xs:element name="refresh" type="refresh"/>
				<xs:element name="replay" type="replay"/>
				<xs:element name="health" type="health"/>
				<xs:element name="alias">
					<xs:complexType>
						<xs:attribute name="from" type="xs:string" use="required"/>
						<xs:attribute name="to" type="xs:string" use="required"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="identity" type="identity"/>
				<xs:element name="whoami" type="whoami"/>
				<xs:element name="credential" type="credential"/>
			</xs:choice>
			<xs:attribute name="name" type="xs:string" use="required"/>
			<xs:attribute name="schema" type="xs:string"/>
			<!-- Starts every header the engine sets on an answer. Default X-Mirror-. -->
			<xs:attribute name="header-prefix" type="xs:string"/>
			<!-- Caps every resource table; oldest writes go first. Default 1000000. -->
			<xs:attribute name="max-rows" type="xs:string"/>
		</xs:complexType>
	</xs:element>

	<xs:complexType name="vars">
		<xs:sequence>
			<xs:element name="var" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType mixed="true">
					<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
					<xs:attribute name="name" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="upstream">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="header" type="upstreamHeaderType"/>
			<xs:element name="forward">
				<xs:complexType>
					<xs:attribute name="name" type="xs:string" use="required"/>
					<xs:attribute name="required" type="xs:boolean"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="app">
				<xs:complexType>
					<xs:attribute name="id" type="xs:string" use="required"/>
					<xs:attribute name="key" type="xs:string"/>
					<xs:attribute name="key-file" type="xs:string"/>
					<xs:attribute name="installations" type="xs:string" use="required"/>
					<xs:attribute name="account" type="xs:string" use="required"/>
					<xs:attribute name="mint" type="xs:string" use="required"/>
					<xs:attribute name="owner-key" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<!-- Which headers carry a budget is the upstream's own vocabulary. -->
			<xs:element name="ratelimit">
				<xs:complexType>
					<xs:attribute name="limit" type="xs:string"/>
					<xs:attribute name="remaining" type="xs:string"/>
					<xs:attribute name="used" type="xs:string"/>
					<xs:attribute name="reset" type="xs:string"/>
					<xs:attribute name="resource" type="xs:string"/>
					<xs:attribute name="refusal" type="xs:string"/>
					<xs:attribute name="answer" type="xs:string"/>
					<xs:attribute name="poll" type="xs:string"/>
					<xs:attribute name="poll-field" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="base" type="xs:string" use="required"/>
		<xs:attribute name="debounce" type="xs:string"/>
		<xs:attribute name="retry-after" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="headerType" mixed="true">
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="background" type="xs:boolean"/>
	</xs:complexType>

	<!-- credential= renders that <credential>'s token as `.credential`, on a call with no caller only. -->
	<xs:complexType name="upstreamHeaderType" mixed="true">
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="credential" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="resource">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="key">
				<xs:complexType>
					<xs:attribute name="name" type="xs:string" use="required"/>
					<xs:attribute name="from" type="xs:string"/>
					<xs:attribute name="fold" type="xs:boolean"/>
					<!-- The key is a fingerprint of the caller's own credential. -->
					<xs:attribute name="credential">
						<xs:simpleType>
							<xs:restriction base="xs:string">
								<xs:enumeration value="true"/>
								<xs:enumeration value="false"/>
								<xs:enumeration value="principal"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:attribute>
					<!-- The JSON type a key with from= is served as: text or int. -->
					<xs:attribute name="type" type="fieldType"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="field">
				<xs:complexType mixed="true">
					<xs:attribute name="name" type="xs:string" use="required"/>
					<xs:attribute name="type" type="fieldType"/>
					<xs:attribute name="expr" type="xs:string"/>
					<xs:attribute name="version" type="xs:boolean"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="drop">
				<xs:complexType>
					<xs:attribute name="key" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="keep">
				<xs:complexType>
					<xs:attribute name="name" type="xs:string" use="required"/>
					<xs:attribute name="reason" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="reveal" type="reveal"/>
			<xs:element name="contradicted-by">
				<xs:complexType>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="on">
							<xs:complexType>
								<xs:attribute name="key" type="xs:string" use="required"/>
								<xs:attribute name="column" type="xs:string" use="required"/>
							</xs:complexType>
						</xs:element>
						<xs:element name="only">
							<xs:complexType>
								<xs:attribute name="column" type="xs:string" use="required"/>
								<xs:attribute name="value" type="xs:string" use="required"/>
							</xs:complexType>
						</xs:element>
					</xs:choice>
					<xs:attribute name="resource" type="xs:string" use="required"/>
					<xs:attribute name="field" type="xs:string" use="required"/>
					<xs:attribute name="against" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<!-- How long a store="redirect" Location lives: its signed expiry, less a margin. -->
			<xs:element name="redirect">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="expires" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:attribute name="param" type="xs:string" use="required"/>
								<xs:attribute name="format" type="xs:string"/>
								<xs:attribute name="since" type="xs:string"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="margin" type="xs:string"/>
					<xs:attribute name="unsigned" type="xs:string"/>
					<xs:attribute name="fallback" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="ttl" type="xs:string"/>
		<!-- columns (default), document, redirect, or text. -->
		<xs:attribute name="store" type="xs:string"/>
		<xs:attribute name="revoke-on-refusal" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="identityRule">
		<xs:attribute name="header" type="xs:string"/>
		<xs:attribute name="as" type="xs:string"/>
		<xs:attribute name="scheme" type="xs:string"/>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="principal" type="xs:string" use="required"/>
		<xs:attribute name="name" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="reveal">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="public" type="content"/>
			<xs:element name="probe">
				<xs:complexType>
					<xs:attribute name="method" type="xs:string"/>
					<xs:attribute name="path" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="grant" type="ttlType"/>
			<xs:element name="deny" type="ttlType"/>
			<!-- Self-gating: the row is only ever replayed to the credential it was fetched with. -->
			<xs:element name="credential"/>
		</xs:choice>
	</xs:complexType>

	<xs:complexType name="ttlType">
		<xs:attribute name="ttl" type="xs:string" use="required"/>
	</xs:complexType>

	<xs:complexType name="route">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="accept" type="xs:string"/>
			<xs:element name="param">
				<xs:complexType>
					<xs:attribute name="name" type="xs:string" use="required"/>
					<xs:attribute name="type" type="fieldType"/>
					<xs:attribute name="default" type="xs:string"/>
					<xs:attribute name="min" type="xs:integer"/>
					<xs:attribute name="max" type="xs:integer"/>
					<xs:attribute name="key" type="xs:boolean"/>
					<!-- A bool flag that serves this answer path as an empty array. -->
					<xs:attribute name="empties" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<!-- A path parameter's required shape; a request without it tries the next route. -->
			<xs:element name="match">
				<xs:complexType>
					<xs:attribute name="param" type="xs:string" use="required"/>
					<xs:attribute name="pattern" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="absorb">
				<xs:complexType>
					<xs:attribute name="status" type="xs:integer" use="required"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="map">
				<xs:complexType>
					<xs:attribute name="param" type="xs:string" use="required"/>
					<xs:attribute name="key" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<!-- Each item of the answer is a grant for the caller, and optionally truth. -->
			<xs:element name="spread">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="key" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType mixed="true">
								<xs:attribute name="field" type="xs:string" use="required"/>
								<xs:attribute name="expr" type="xs:string"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="resource" type="xs:string" use="required"/>
					<xs:attribute name="items" type="xs:string"/>
					<xs:attribute name="absorb" type="xs:boolean"/>
					<xs:attribute name="grant" type="xs:boolean"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="method" type="xs:string"/>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="resource" type="xs:string" use="required"/>
		<xs:attribute name="ttl" type="xs:string"/>
		<xs:attribute name="list" type="xs:boolean"/>
		<xs:attribute name="complete" type="xs:boolean"/>
		<!-- The resource key the REQUEST body fills, for a route that posts its question. -->
		<xs:attribute name="body-key" type="xs:string"/>
		<xs:attribute name="bypass" type="xs:string"/>
		<xs:attribute name="assert" type="xs:boolean"/>
	</xs:complexType>

	<!-- A write whose answer the mirror cannot derive: forward it, drop the row. -->
	<xs:complexType name="purge">
		<xs:attribute name="method" type="xs:string" use="required"/>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="resource" type="xs:string" use="required"/>
	</xs:complexType>

	<!-- A path prefix a client insists on, canonicalised before anything matches it. -->
	<xs:complexType name="rewrite">
		<xs:attribute name="from" type="xs:string" use="required"/>
		<xs:attribute name="to" type="xs:string"/>
	</xs:complexType>

	<!-- An uncached forward to a fixed URL off the upstream base, for a login host. -->
	<xs:complexType name="relay">
		<xs:attribute name="method" type="xs:string" use="required"/>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="to" type="xs:string" use="required"/>
	</xs:complexType>

	<xs:complexType name="events">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="secret" type="content"/>
			<xs:element name="event" type="event"/>
			<xs:element name="subscriptions">
				<xs:complexType>
					<xs:attribute name="path" type="xs:string" use="required"/>
					<xs:attribute name="field" type="xs:string" use="required"/>
					<xs:attribute name="always" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<!-- Asks the provider which types it sends, for the dashboard. -->
			<xs:element name="subscribed">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="header" type="headerType" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:attribute name="method" type="xs:string"/>
					<xs:attribute name="path" type="xs:string" use="required"/>
					<xs:attribute name="field" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="signature-header" type="xs:string" use="required"/>
		<xs:attribute name="type-header" type="xs:string" use="required"/>
		<xs:attribute name="reorder-window" type="xs:string"/>
		<!-- The provider's own delivery id, passed on to subscribers. -->
		<xs:attribute name="id-header" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="event">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="subject" type="content"/>
			<xs:element name="apply">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="set" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType mixed="true">
								<xs:attribute name="field" type="xs:string" use="required"/>
								<xs:attribute name="expr" type="xs:string"/>
								<xs:attribute name="null" type="xs:string"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="key" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType mixed="true">
					<xs:attribute name="field" type="xs:string" use="required"/>
					<xs:attribute name="expr" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<!-- The payload path whose object becomes a document resource's answer. -->
			<xs:element name="document" type="xs:string"/>
			<xs:element name="invalidate">
				<xs:complexType>
					<xs:attribute name="reason" type="xs:string" use="required"/>
					<xs:attribute name="reason" type="xs:string" use="required"/>
					<!-- Drops every row, for a key the payload cannot state. -->
					<xs:attribute name="every" type="xs:boolean"/>
					<!-- Drop only when stored `field` differs from the payload at `differs`. -->
					<xs:attribute name="field" type="xs:string"/>
					<xs:attribute name="differs" type="xs:string"/>
					<xs:attribute name="all" type="xs:boolean"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="type" type="xs:string" use="required"/>
		<xs:attribute name="resource" type="xs:string" use="required"/>
		<xs:attribute name="clock" type="xs:string"/>
		<!-- A predicate over `.payload`; false skips this event. -->
		<xs:attribute name="when" type="xs:string"/>
		<xs:attribute name="unordered" type="xs:boolean"/>
		<xs:attribute name="absorb-when-superseded" type="xs:boolean"/>
		<xs:attribute name="action" type="xs:string"/>
		<xs:attribute name="when" type="xs:string"/>
	</xs:complexType>

	<!--
		Operations. None of this changes an answer; all of it changes whether
		anybody can tell that the answers are right.
	-->

	<!-- The surface exists either way. This says where it lives and what gates it. -->
	<xs:complexType name="dashboard">
		<xs:sequence>
			<xs:element name="token" type="content" minOccurs="0"/>
			<xs:element name="sign-in" minOccurs="0">
				<xs:complexType>
					<xs:attribute name="client-id" type="xs:string" use="required"/>
					<xs:attribute name="client-secret" type="xs:string" use="required"/>
					<xs:attribute name="authorize" type="xs:string" use="required"/>
					<xs:attribute name="exchange" type="xs:string" use="required"/>
					<xs:attribute name="user" type="xs:string" use="required"/>
					<xs:attribute name="login" type="xs:string" use="required"/>
					<xs:attribute name="admins" type="xs:string"/>
					<xs:attribute name="secret" type="xs:string"/>
					<xs:attribute name="base-url" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<!-- An OAuth code flow in front of the dashboard; the upstream names the operator. -->
			<xs:element name="login" minOccurs="0">
				<xs:complexType>
					<xs:choice minOccurs="0" maxOccurs="unbounded">
						<xs:element name="client-id" type="content"/>
						<xs:element name="client-secret" type="content"/>
						<xs:element name="session-secret" type="content"/>
						<xs:element name="admins" type="content"/>
						<xs:element name="base-url" type="content"/>
					</xs:choice>
					<xs:attribute name="authorize" type="xs:string" use="required"/>
					<xs:attribute name="exchange" type="xs:string" use="required"/>
					<xs:attribute name="user" type="xs:string" use="required"/>
					<xs:attribute name="name" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="path" type="xs:string"/>
		<xs:attribute name="title" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="cors">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="origin" type="xs:string"/>
			<!-- Without this a browser hides the headers from a cross-origin script. -->
			<xs:element name="expose" type="xs:string"/>
		</xs:choice>
		<xs:attribute name="max-age" type="xs:string"/>
	</xs:complexType>

	<!-- db= is optional: it otherwise sits beside whatever -db names. -->
	<xs:complexType name="notify">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<!-- Template source over `.payload`; a subscription filter matches it. -->
			<xs:element name="scope" type="content"/>
			<!-- The row a subscriber must be able to see, by stored proof only. -->
			<xs:element name="reveal">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="key" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType mixed="true">
								<xs:attribute name="field" type="xs:string" use="required"/>
								<xs:attribute name="expr" type="xs:string"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="resource" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<!-- A body field: a payload path, or expr= over `.payload` and `.delivery`. -->
			<xs:element name="field">
				<xs:complexType mixed="true">
					<xs:attribute name="name" type="xs:string" use="required"/>
					<xs:attribute name="expr" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="scope-field" type="xs:string"/>
		<xs:attribute name="event-header" type="xs:string"/>
		<xs:attribute name="delivery-header" type="xs:string"/>
		<xs:attribute name="db" type="xs:string"/>
		<!-- Template source over `.env` and `.var`: a github-state-mirror registry to adopt at startup. -->
		<xs:attribute name="import" type="xs:string"/>
		<xs:attribute name="signature-header" type="xs:string"/>
		<xs:attribute name="timeout" type="xs:string"/>
		<xs:attribute name="retries" type="xs:integer"/>
		<xs:attribute name="disable-after" type="xs:integer"/>
	</xs:complexType>

	<!-- No <kind> sweeps every resource some route serves. -->
	<xs:complexType name="refresh">
		<xs:sequence>
			<xs:element name="kind" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="interval" type="xs:string"/>
	</xs:complexType>

	<xs:complexType name="replay">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<!-- Replaces an upstream header on the replayer's own calls. -->
			<xs:element name="header" type="headerType"/>
			<xs:element name="list" type="xs:string"/>
			<!-- Template source over `.delivery`. -->
			<xs:element name="redeliver" type="content"/>
			<xs:element name="id" type="xs:string"/>
			<xs:element name="at" type="xs:string"/>
		</xs:choice>
		<xs:attribute name="interval" type="xs:string"/>
		<xs:attribute name="method" type="xs:string"/>
		<xs:attribute name="lookback" type="xs:string"/>
		<xs:attribute name="max" type="xs:integer"/>
		<!-- Empty at startup means the replayer declines to start, and says so. -->
		<xs:attribute name="requires" type="xs:string"/>
	</xs:complexType>

	<!-- Unregistered, these fall through to the proxy rather than 404ing. -->
	<xs:complexType name="health">
		<xs:attribute name="live" type="xs:string"/>
		<xs:attribute name="pre-update" type="xs:string"/>
	</xs:complexType>

	<!-- The call that names a credential's owner, as `prefix:id`. -->
	<xs:complexType name="whoami">
		<xs:attribute name="method" type="xs:string"/>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="id" type="xs:string" use="required"/>
		<xs:attribute name="prefix" type="xs:string" use="required"/>
		<xs:attribute name="ttl" type="xs:string"/>
	</xs:complexType>

	<!-- A verified assertion in `header` names the caller as `prefix:id`. -->
	<xs:complexType name="identity">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="user" type="identityRule"/>
			<xs:element name="assertion" type="identityRule"/>
		</xs:choice>
		<xs:attribute name="header" type="xs:string" use="required"/>
		<xs:attribute name="method" type="xs:string"/>
		<xs:attribute name="path" type="xs:string" use="required"/>
		<xs:attribute name="send" type="xs:string"/>
		<xs:attribute name="scheme" type="xs:string"/>
		<xs:attribute name="id" type="xs:string" use="required"/>
		<xs:attribute name="name" type="xs:string"/>
		<xs:attribute name="prefix" type="xs:string" use="required"/>
		<xs:attribute name="ttl" type="xs:string"/>
	</xs:complexType>

	<!--
		A token obtained by an exchange, cached until `margin` before it
		expires. `for` is template source over `.key` that picks the token.
		Empty `requires` turns the credential off.
	-->
	<xs:complexType name="credential">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<!-- Authenticates the lookup and the exchange. -->
			<xs:element name="header" type="headerType"/>
			<!-- Finds the value the exchange path reads as `.lookup`. -->
			<xs:element name="lookup">
				<xs:complexType>
					<xs:attribute name="method" type="xs:string"/>
					<xs:attribute name="path" type="xs:string" use="required"/>
					<xs:attribute name="field" type="xs:string" use="required"/>
					<xs:attribute name="ttl" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="exchange">
				<xs:complexType>
					<xs:attribute name="method" type="xs:string"/>
					<xs:attribute name="path" type="xs:string" use="required"/>
					<xs:attribute name="token" type="xs:string" use="required"/>
					<xs:attribute name="expires" type="xs:string"/>
					<xs:attribute name="ttl" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="requires" type="xs:string"/>
		<xs:attribute name="for" type="xs:string"/>
		<xs:attribute name="margin" type="xs:string"/>
	</xs:complexType>

</xs:schema>
